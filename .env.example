# Databáze
DATABASE_URL="file:/data/tankride.db"

# NextAuth
NEXTAUTH_SECRET="nahodny-tajny-klic-pro-sifrovani-session"
NEXTAUTH_URL="http://localhost:3000"

# AI skenování účtenek a tachometru (volitelné)
# Pokud je klíč nastaven, v aplikaci se automaticky zobrazí tlačítka pro focení/skenování.
# Pokud klíč nezadáte, aplikace funguje standardně v plně manuálním režimu bez volání externích API.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"

# AGU Design Sentinel - Centrální perimetrová ochrana
SENTINEL_REPORT_URL="http://agudesign_sentinel:8000/api/v1/report"
SENTINEL_API_TOKEN="agu_sentinel_secret_token_change_me"
